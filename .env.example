# Copy this file to .env and fill in real values. Never commit .env.

# Domain (used by Traefik and email links)
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173

# Environment: local | dev | staging | production
ENVIRONMENT=local

PROJECT_NAME="Plains"
STACK_NAME=plains

# Backend — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=CHANGE_THIS

# CORS — comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS="http://localhost:5173"

# Postgres — use a strong password in staging/production
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS

# Email (leave blank to disable email features)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Sentry (optional)
SENTRY_DSN=

# NOMAD
NOMAD_URL=http://host.docker.internal/nomad-oasis/api/v1
NOMAD_OAUTH_ENABLED=true
NOMAD_OAUTH_CLIENT_ID=nomad_public
NOMAD_KEYCLOAK_REALM_URL=https://nomad-lab.eu/fairdi/keycloak/auth/realms/fairdi_nomad_prod
NOMAD_USE_GLOBAL_AUTH=true
NOMAD_MOCK_MODE=false

# Docker image names
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
