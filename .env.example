# Copy this file to .env and fill in real values. Never commit .env.

# Domain (used by Traefik and email links)
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173

# Environment: local | dev | staging | production
ENVIRONMENT=local

PROJECT_NAME="Plains"
STACK_NAME=plains

# Backend — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=CHANGE_THIS

# CORS — comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS="http://localhost:5173"

# Access whitelist — comma-separated list of pre-authorised account emails
# (typically the NOMAD accounts allowed to use this deployment). Leave EMPTY to
# disable the whitelist (any authenticated account is accepted — legacy behaviour).
# When set, ONLY these emails may authenticate, sign up, or be auto-provisioned;
# every other account is rejected with HTTP 403. Matching is case-insensitive and
# FIRST_SUPERUSER is always implicitly allowed. Strongly recommended for any
# public-facing deployment.
ALLOWED_EMAILS=""

# Open registration — gates ONLY the anonymous local self-signup route
# (POST /users/signup). Defaults to True in code, so it MUST be set False for a
# public deployment or anyone can create a local account. This does NOT affect
# NOMAD OAuth login: whitelisted accounts are still auto-provisioned on first
# OAuth login (gated by ALLOWED_EMAILS, not by this flag). For a private lab
# deployment set this False and rely on NOMAD_OAUTH_ENABLED + ALLOWED_EMAILS.
USERS_OPEN_REGISTRATION=False

# Postgres — use a strong password in staging/production
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS

# Email (leave blank to disable email features)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Sentry (optional)
SENTRY_DSN=

# NOMAD
NOMAD_URL=http://host.docker.internal/nomad-oasis/api/v1
# Auth mode. true = log in with NOMAD/Keycloak OAuth tokens (RS256), and local
# password login is disabled. REQUIRED to be true in staging/production (the
# config validator refuses to boot otherwise). false = local HS256 password
# login only (dev convenience).
NOMAD_OAUTH_ENABLED=true
NOMAD_OAUTH_CLIENT_ID=nomad_public
NOMAD_KEYCLOAK_REALM_URL=https://nomad-lab.eu/fairdi/keycloak/auth/realms/fairdi_nomad_prod
NOMAD_USE_GLOBAL_AUTH=true
NOMAD_MOCK_MODE=false

# Docker image names
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
