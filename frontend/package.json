{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:with-chat": "concurrently \"npm run dev-rasa\" \"npm run dev\"",
    "dev-rasa": "node mock-rasa-server.js",
    "generate-routes": "node scripts/generate-route-tree.mjs",
